# ==========================================================
# FarmasilERP — .gitignore
# ==========================================================

# --- Instrucciones locales para agentes de IA (no se suben) ---
AGENTS.md

# --- Dependencias ---
node_modules/
bower_components/
vendor/
.pnp
.pnp.*
.yarn/*
!.yarn/releases
!.yarn/plugins

# --- Builds y artefactos ---
dist/
build/
out/
release/
*.tsbuildinfo
.cache/
.parcel-cache/
.vite/
.next/
.nuxt/
.svelte-kit/

# --- Python (por si el stack lo requiere) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# --- Variables de entorno y secretos ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Datos locales de la aplicación (nunca se versionan) ---
*.db
*.db-journal
*.sqlite
*.sqlite3
/data/
/backups/
/respaldos/
*.bak

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Pruebas y cobertura ---
coverage/
.nyc_output/
test-results/
playwright-report/

# --- Editores e IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- Sistema operativo ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Documentos temporales de Office ---
~$*
/datos/
